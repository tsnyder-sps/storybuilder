<style>
  /* --- Layout wrappers --- */
  .two-column-layout {
    display: flex;
    gap: 30px; /* Increased gap for breathing room */
    width: 100%;
    align-items: flex-start; /* Prevents columns from stretching unnecessarily */
  }
  .left-column {
    width: 35%;
    flex-shrink: 0;
    background-color: #f8f9fa; /* Slightly lighter gray */
    padding: 25px;
    border-radius: 8px; /* Rounded card look */
    box-shadow: 0 2px 5px rgba(0,0,0,0.05); /* Subtle shadow */
    border: 1px solid #e9ecef;
  }
  .right-column {
    flex-grow: 1;
    background-color: #fff;
    padding: 25px;
    border-radius: 8px;
    border: 1px solid #e9ecef;
    min-height: 500px; /* Visual balance if empty */
  }
  h4 {
    font-weight: 600;
    color: #495057;
    margin-bottom: 5px;
    display: block; /* Ensures label sits above input */
    font-size: 1rem;
  }

  .application-header {
    text-align: center;
    margin-bottom: 30px;
    color: #2c3e50;
  }
/* --- Form elements --- */
  form {
    display: flex;
    flex-direction: column;
    gap: 15px; /* Spacing between form groups */
  }
  label {
    font-weight: 600;
    color: #495057;
    margin-bottom: 5px;
    display: block; /* Ensures label sits above input */
    font-size: 0.8rem;
  }
/* Unified Input Styles */
  .narrative-input, 
  input[type="number"], 
  select {
    width: 100%;
    padding: 10px;
    border: 1px solid #ced4da;
    border-radius: 5px;
    font-family: inherit;
    font-size: 0.8rem;
    box-sizing: border-box; /* Prevents padding from breaking width */
    transition: border-color 0.2s;
  }
  .narrative-input {
    height: 80px; /* Slightly taller for ease of typing */
    resize: none; /* Prevents resizing */
  }
  /* Focus States (Accessibility & UI) */
  .narrative-input:focus, 
  input[type="number"]:focus, 
  select:focus {
    outline: none;
    border-color: #80bdff;
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.15); /* Blue glow */
  }
  /* --- BUTTONS --- */
  button {
    cursor: pointer;
    font-family: inherit;
    font-weight: 600;
    border: none;
    border-radius: 5px;
    padding: 10px 20px;
    font-size: 0.9rem;
    transition: all 0.2s ease;
    display: inline-block;
  }
  /* Primary Action Buttons (Generate) */
  #generateButton, 
  #quizGenerateButton {
    background-color: #007bff; /* Primary Blue */
    color: white;
    width: 100%; /* Full width for main actions */
    margin-top: 10px;
  }
  #generateButton:hover, 
  #quizGenerateButton:hover {
    background-color: #0056b3;
    transform: translateY(-1px); /* Subtle lift effect */
  }
  /* Secondary Buttons (View Toggles) */
  #selectNarrative, 
  #selectQuiz {
    background-color: #6c757d; /* Gray */
    color: white;
    margin-right: 5px;
  }
  #selectNarrative:hover, 
  #selectQuiz:hover {
    background-color: #5a6268;
  }
  /* Success/Export Buttons */
  #exportNarrativeBtn, 
  #exportQuizBtn {
    background-color: #28a745; /* Green */
    color: white;
    margin-top: 15px;
    font-size: 0.85rem;
  }
  #exportNarrativeBtn:hover, 
  #exportQuizBtn:hover {
    background-color: #218838;
  }
  /* --- OUTPUT AREA --- */
  .aiResponse {
    margin-bottom: 20px;
    line-height: 1.6;
    color: #333;
    font-size: 1.05rem;
  }
  /* Headings inside the AI response */
  .aiResponse h1, .aiResponse h2, .aiResponse h3 {
    margin-top: 0;
    color: #2c3e50;
  }
  .cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: #2196f3;
    margin-left: 2px;
    animation: blink 1s infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
}

  .exportBtn {
    background-color: #28a745;
    color: white;
  }
</style>

  <div class="application-header">
    <h2>Story & Quiz Generator</h2>
  </div>
  
  <div class="two-column-layout">
    <div class="left-column">
      <div class="narrative-generation">
        <h4>Generate a narrative here:</h4>
        <form>
          <label for="vocab" id="vocabLabel">Enter comma separated target vocab here:</label>
          <textarea id="vocab" class="narrative-input"></textarea> 
          <label for="tense" id="tenseLabel">Enter comma separated target verb tenses here:</label>
          <textarea id="tense" class="narrative-input"></textarea>
          <label id="optionsLabel" for="options">Enter additional instructions here (leave blank if none):</label>
          <textarea id="options" class="narrative-input"></textarea>
          <label id="paragraphLabel" for="paragraphCount">Number of paragraphs:</label>
          <input type="number" id="paragraphCount" min="1" max="1000"></input>
          <label id="languageLabel" for="languageSelect">Target language:</label>
          <select name="language" id="languageSelect">
            <option value="french" selected>French</option>
            <option value="spanish">Spanish</option>
            <option value="english">English</option>
          </select>
          <button id="generateButton">Generate narrative</button>
        </form>
        <h4>Generate an MCQ quiz about the narrative:</h4>
        <form>
          <label id="questionsLabel" for="questionCount">Number of questions:</label>
          <input type="number" id="questionCount" min="1" max="100"></input>
          <label id="questionOptionLabel" for="questionOption">Number of options per question:</label>
          <input type="number" id="questionOption" min="2" max="6"></input>
          <button id="quizGenerateButton">Generate MCQ quiz</button>
        </form>
      </div>
    </div>

    <div class="right-column">
      <div class="response-elements">
        <h4 >Results will appear here:</h4>
        <!--AI response elements from server-->
        <div id="aiResponseBackground" class="aiResponse scrollable"></div>
        <div id="aiResponse" class="aiResponse scrollable"></div>
        <br />
        <button id="selectNarrative">View narrative</button>
        <button id="selectQuiz">View quiz</button>

        <button id="exportNarrativeBtn" class="exportBtn">Export Narrative</button>
        <button id="exportQuizBtn" class="exportBtn">Export Quiz</button>
      </div>
    </div>
  </div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
  // Response storage
  var narrativeResponse = "";
  var quizResponse = "";
  var narrativeTitle = "";

  // Set user input default values
  document.getElementById("paragraphCount").value = 5;
  document.getElementById("questionCount").value = 10;
  document.getElementById("questionOption").value = 4;

  // Select elements for narrative generation
  const vocabElement = document.getElementById("vocab");
  const tenseElement = document.getElementById("tense");
  const optionsElement = document.getElementById("options");
  const paragraphCountElement = document.getElementById("paragraphCount");
  const languageSelectElement = document.getElementById("languageSelect");
  const generateButton = document.getElementById("generateButton");

  // Select elements for quiz generation
  const questionCountElement = document.getElementById("questionCount");
  const questionOptionElement = document.getElementById("questionOption");
  const quizGenerateButton = document.getElementById("quizGenerateButton");
  
  
  // Load narrative response to response box
  function loadNarrative() {
    if (narrativeResponse != "") {
      //make sure narrative exists
      document.getElementById("aiResponse").innerHTML = marked.parse(narrativeResponse);
    } else {
      document.getElementById("aiResponse").innerHTML = 
        "There is no narrative to display.<br />" +
        "Please generate a narrative first.";
    }
  }

  // Load quiz response to response box
  function loadQuiz() {
    if (quizResponse != "") {
      //make sure quiz exists
      document.getElementById("aiResponse").innerHTML = marked.parse(quizResponse);
    } else {
      document.getElementById("aiResponse").innerHTML = 
        "There is no quiz to display.<br />" +
        "Please generate a quiz first.";
    }
  }
  
  // Select narrative button
  document.getElementById("selectNarrative").addEventListener("click", () => {
    loadNarrative();
  });

  // Select quiz button
  document.getElementById("selectQuiz").addEventListener("click", () => {
    loadQuiz();
  });

  // This function creates a .doc file from HTML content
 function exportToDoc(filename, content) {
    // 1. Define the XML Namespaces Word needs
    // 2. Add an embedded CSS block to force styling
    const header = `
      <html xmlns:o='urn:schemas-microsoft-com:office:office' 
            xmlns:w='urn:schemas-microsoft-com:office:word' 
            xmlns='http://www.w3.org/TR/REC-html40'>
      <head>
        <meta charset='utf-8'>
        <title>Export</title>
        <style>
          /* Set the default document font */
          body { 
            font-family: 'Times New Roman', serif; 
            font-size: 12pt; 
            line-height: 1.5; 
            margin: 0;
            padding: 0;
          }
          
          /* CRITICAL FIX: Reset margins on standard tags */
          /* This stops the first paragraph from jumping or having huge gaps */
          p { margin: 0 0 1em 0; }
          
          h1 { font-size: 18pt; margin-bottom: 0.5em; font-weight: bold; }
          h2 { font-size: 16pt; margin-bottom: 0.5em; font-weight: bold; }
          h3 { font-size: 14pt; margin-bottom: 0.5em; font-weight: bold; }
          
          /* Quiz specific styling (if you use lists) */
          ul, ol { margin-top: 0; margin-bottom: 1em; }
        </style>
      </head>
      <body>
      <div class="Section1">
    `;

    const footer = `
      </div>
      </body>
      </html>
    `;
    
    // Combine them
    // Note: We use marked.parse(content) in the button listener, so 'content' passed here is already HTML
    const sourceHTML = header + content + footer;
    
    // Create the Blob
    const source = 'data:application/vnd.ms-word;charset=utf-8,' + encodeURIComponent(sourceHTML);
    
    // Trigger Download
    const fileDownload = document.createElement("a");
    document.body.appendChild(fileDownload);
    fileDownload.href = source;
    fileDownload.download = filename + '.doc';
    fileDownload.click();
    document.body.removeChild(fileDownload);
  }
// Generate narrative
  generateButton.addEventListener("click", async (e) => {
    e.preventDefault();

    // Capture user input
    const vocab = vocabElement.value;
    const tense = tenseElement.value;
    const paragraphCount = paragraphCountElement.value;
    const language = languageSelectElement.value;

    let addOptions = optionsElement.value;

    document.getElementById("aiResponse").innerHTML = '<div class="loader"></div> Generating...';
    const cursor = document.createElement('span');
    cursor.className = "cursor";
    document.getElementById("aiResponse").appendChild(cursor);


    // Reset global variable
    narrativeResponse = "";

    // Validate user input
    if (vocab === "") {
      document.getElementById("aiResponse").innerHTML = "Please enter at least one vocabulary word.";
      return;
    } else if (tense === "") {
      document.getElementById("aiResponse").innerHTML = "Please enter at least one verb tense.";
      return;
    }
    
    if (addOptions !== "") {
        addOptions = addOptions;
    } else {
        addOptions = "No additional instructions.";
    }

    console.log("Sending request to server with data:", vocab, tense, addOptions, paragraphCount, language);

    // Send request to server
    try {
      // 1. Initiate the POST request
      const response = await fetch("/world-language/narrative-generator/narrative", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
            vocab: vocab,
            tense: tense,
            additional: addOptions,
            paragraphCount: paragraphCount,
            language: language
        }),
      });

      if (!response.ok) {
        throw new Error(`Server error: ${response.statusText}`);
      }

      const data = await response.json();
      narrativeTitle = data.title || "Generated Narrative";
      narrativeResponse = data.story;
      // document.getElementById("responseLabel").innerHTML = ""
      //document.getElementById("responseLabel").innerHTML = `<h4>${narrativeTitle}</h4>`;
      const displayHTML = `<h4>${narrativeTitle}</h4>` + marked.parse(narrativeResponse);
      document.getElementById("aiResponse").innerHTML = displayHTML;      
    } catch (error) {
      console.error(error);
      document.getElementById("aiResponse").innerHTML = 
        "An error occurred while generating the narrative. Please try again.";
    }

    return false;
  });

  // EXPORT BUTTON LISTENERS
  
  document.getElementById("exportNarrativeBtn").addEventListener("click", (e) => {
      e.preventDefault();
      if (!narrativeResponse) { alert("Please generate a narrative first."); return; }
      const htmlContent = `<h1>${narrativeTitle}</h1>` + marked.parse(narrativeResponse);
      // Use the AI-generated title for the filename
      exportToDoc(narrativeTitle, htmlContent);
  });

  document.getElementById("exportQuizBtn").addEventListener("click", (e) => {
      e.preventDefault();
      if (!quizResponse) { alert("Please generate a quiz first."); return; }
      
      // Filename: Title + "_Quiz"
      exportToDoc(narrativeTitle + "_Quiz", quizResponse);
  });

    // Generate quiz
  quizGenerateButton.addEventListener("click", async (e) => {
    e.preventDefault();
    // Capture user input
    const questions = questionCountElement.value;
    const mcqOptions = questionOptionElement.value;
    const language = languageSelectElement.value;

    let addOptions = optionsElement.value;

    document.getElementById("aiResponse").innerHTML = "Generating quiz...";
    const cursor = document.createElement('span');
    cursor.className = "cursor";
    document.getElementById("aiResponse").appendChild(cursor);

    // Validate user input
    if (questions === "") {
      document.getElementById("aiResponse").innerHTML = 
        "Please enter at least one question.";
      return;
    } else if (mcqOptions === "") {
      document.getElementById("aiResponse").innerHTML = 
        "Please enter at least one multiple choice option.";
      return;
    }

    // Send request to server
    try {
      const response = await fetch("/world-language/narrative-generator/quiz", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({language: language,questionCount: questions,optionCount: mcqOptions,narrative: narrativeResponse}),
      });

      if (!response.ok) {
        throw new Error(`Server error: ${response.statusText}`);
      }

      const data = await response.json();

      // Update quiz response
      quizResponse = data.completion;

      // Render result
      document.getElementById("aiResponse").innerHTML = marked.parse(quizResponse);
    } catch (error) {
      console.error("Error generating quiz:", error);
      document.getElementById("aiResponse").innerHTML = 
        "An error occurred while generating the quiz. Please try again.";
    }

    return false;
  });

</script>